# Copy this file to ".env" and fill in your values. ".env" is git-ignored (never commit secrets).

PORT=3000

# --- Database (matches docker-compose.yml) ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=atyourservice
DB_PASSWORD=atyourservice
DB_NAME=atyourservice


# --- LLM (Claude). Paid, pay-as-you-go: create a key at https://console.anthropic.com ---
ANTHROPIC_API_KEY=your-key-here
# Haiku = cheapest (dev). Switch to claude-sonnet-5-5 for a better demo.
CLAUDE_MODEL=claude-haiku-5-5

# --- Auth ---
# Long random string used to sign login tokens. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me
JWT_EXPIRES_IN=1h
# The frontend address allowed to call the API (CORS)
FRONTEND_ORIGIN=http://localhost:5173
# Support agent account created on first start if it does not exist. Change the password!
SEED_AGENT_NAME=IT Support
SEED_AGENT_EMAIL=agent@atyourservice.local
SEED_AGENT_PASSWORD=ChangeMe123!
